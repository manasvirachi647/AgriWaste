# Environment Configuration for AgriWaste Exchange API

# Security
SECRET_KEY=agriwaste-change-this-in-production-random-secret-key-64chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For local SQLite development (no local Postgres setup needed):
DATABASE_URL=sqlite:///./agriwaste.db

# For PostgreSQL (uncomment and replace credentials):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/agriwaste_db
